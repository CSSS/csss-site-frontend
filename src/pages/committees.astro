---
import fasFormal from '@assets/images/events/fas-formal.jpg';
import frosh from '@assets/images/committees/frosh/banner.jpg';
import techFair from '@assets/images/committees/tech-fair.jpg';
import w3 from '@assets/images/committees/w3.jpg';
import banner from '@assets/images/committees/banner.png';
import type { ImageMetadata } from 'astro';

import CommitteeSection from '@components/committees/CommitteeSection.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

interface Committee {
  id: string;
  title: string;
  tagline: string;
  description: string;
  img: ImageMetadata;
}

const committees: Committee[] = [
  {
    id: 'events',
    title: 'Events',
    tagline: 'Spark joy',
    description:
      'Join our three Event Directors on the CSSS Discord to discuss, plan, and run our events.',
    img: fasFormal
  },
  {
    id: 'w3',
    title: 'W3',
    tagline: 'Build and deploy',
    description:
      'The Webmaster and Sys Admin co-chair this committee to develop projects for the CSSS. Contact them through Discord or email to join.',
    img: w3
  },
  {
    id: 'frosh',
    title: 'FROSH',
    tagline: 'Guide our future',
    description:
      'This once-a-year committee is responsible for FROSH week, which welcomes new students to the CSSS community.',
    img: frosh
  },
  {
    id: 'tech-fair',
    title: 'Tech Fair',
    tagline: 'Make connections',
    description:
      'This committee plans our annual career fair, which connects students with local employers.',
    img: techFair
  }
];
---

<SiteLayout title="Committees" description="Join a committee to meet new people!" banner={banner}>
  <article class="content-grid full-width">
    <p>
      Want to be more involved in the CSSS community? Join a committee! Committees are extensions of
      the CSSS that focuses on a specific area of interest. They are a great way to meet new people,
      gain experience, and contribute to the CSSS in a way that aligns with your interests!
    </p>
    {
      committees.map((c, i) => {
        const name = `${c.title} Committee`;
        const isImgRight = !!(i % 2);
        return (
          <CommitteeSection
            id={c.id}
            img={c.img}
            title={c.title}
            alt={name}
            isImgRight={isImgRight}
          >
            <strong>{c.tagline}</strong> with the {name}.
            <br />
            <br />
            {c.description}
          </CommitteeSection>
        );
      })
    }
  </article>
</SiteLayout>

<style>
  article {
    row-gap: var(--sp-8);
  }
</style>
