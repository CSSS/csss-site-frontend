---
import banner from '@assets/images/events/archives/banner.png';
import Button from '@components/buttons/Button.astro';
import { getAccentColour } from 'src/constants';
import SiteLayout from '../../layouts/SiteLayout.astro';

interface Event {
  label: string;
  years: number[];
  baseUrl: string;
}

const events: Event[] = [
  {
    label: 'FROSH',
    years: [
      2025, 2024, 2023, 2022, 2021, 2020, 2019, 2018, 2017, 2016, 2015, 2014, 2013, 2012, 2011
    ],
    baseUrl: 'https://frosh.sfucsss.org/'
  },
  {
    label: 'Fall Hacks',
    years: [2025, 2024, 2020],
    baseUrl: 'https://fall-hacks.sfucsss.org/'
  },
  {
    label: 'Tech Fair',
    years: [2025, 2024, 2023, 2022],
    baseUrl: 'https://tech-fair.sfucsss.org/'
  },
  {
    label: 'Mountain Madness',
    years: [2025, 2024, 2023, 2022, 2021, 2020, 2019],
    baseUrl: 'https://madness.sfucsss.org/'
  }
];
---

<SiteLayout
  title="Event Archives"
  description="See all previous events sites we used for events."
  banner={banner}
>
  <p>For archival purposes, promotional event websites from previous years are listed here.</p>
  <br />
  <br />
  <p>
    <strong>
      Note: The links and the functionality of some of these pages have been altered to ensure the
      pages mostly work, but please be cautious clicking links to sites not affiliated with the
      CSSS.
    </strong>
  </p>
  {events.map((event, i) => {
    return (
      <section>
        <h2>{event.label}</h2>
        <ul class="links">
          {event.years.map(year => (
            <li>
              <Button
                size="lg"
                href={`${event.baseUrl}${year}`}
                tone={getAccentColour(i)}
                target="_blank"
                fullWidth
              >
                {year}
              </Button>
            </li>
          ))}
        </ul>
      </section>
    );
  })}
</SiteLayout>

<style>
  h2 {
    margin-bottom: var(--content-gap);
  }

  .links {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(5rem, 1fr));
    gap: var(--content-gap);
  }
</style>
