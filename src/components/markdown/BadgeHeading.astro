---
import type { Polymorphic } from 'astro/types';

import type { AccentColour } from 'src/constants';

type HeadingTag = 'h2' | 'h3' | 'h4' | 'h5' | 'h6';

type Props<Tag extends HeadingTag> = Polymorphic<{ as: Tag }> & {
  colour?: AccentColour;
};

const {
  as: Heading = 'h2',
  class: className,
  colour = 'red',
  ...props
} = Astro.props as Props<HeadingTag>;
---

<Heading {...props} class:list={['badge-heading', `brand--${colour}`, className]}>
  <slot />
</Heading>

<style>
  .badge-heading {
    width: fit-content;
    padding: var(--sp-3);
    border: solid transparent;
    border-radius: var(--border-radius-default);
  }
</style>
