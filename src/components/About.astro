---
import { Image } from 'astro:assets';
import services from '@assets/images/services.png';
import concernedStudent from '@assets/images/concerned-student.png';
import fallHacks from '@assets/images/events/fall-hacks.png';
import committees from '@assets/images/home/committees.jpg';
import commonRoom from '@assets/images/home/common-room.png';
import officers from '@assets/images/home/officers.jpg';

import DiscordButton from './buttons/DiscordButton.astro';
import CardGallery from './cards/CardGallery.astro';
import type { CardItem } from 'src/types';

const navCards: CardItem[] = [
  {
    label: 'Events',
    img: fallHacks,
    href: '/events'
  },
  {
    label: 'Committees',
    img: committees,
    href: '/committees'
  },
  {
    label: 'Common Room',
    img: commonRoom,
    href: '/common-room'
  },
  {
    label: 'Officers',
    img: officers,
    href: '/officers'
  }
];
---

<article id="about" class="content-grid full-width">
  <section class="intro">
    <h2 class="heading">
      <span class="heading__top">THE</span>
      <span class="heading__bottom">CSSS</span>
    </h2>
    <section>
      <h3>Welcome!</h3>
      <p>
        The CSSS represents thousands of students at Simon Fraser University. We are a student-run
        organization, providing a variety of services and hosting events to enhance the student
        experience.
      </p>
    </section>
  </section>
  <section class="membership">
    <h2 class="h2">If you're an undergraduate student...</h2>
    <ul class="list">
      <li>
        who has declared a major, minor, or are in an honours program offered by the School of
        Computing Science, or
      </li>
      <li>are taking any undergraduate course offered by the School of Computing Science</li>
    </ul>
    <p class="h2">...then you're already a member!</p>
    <p>
      Join us on Discord and get involved with one of the biggest student groups at Simon Fraser
      University.
    </p>
    <div class="button-container">
      <DiscordButton size="lg" />
    </div>
  </section>
  <hr />
  <section class="services">
    <Image
      class="services__student"
      src={concernedStudent}
      alt="concerned student"
      width={500}
      quality="max"
    />
    <Image
      class="services__concerns"
      src={services}
      alt="CSSS services"
      width={500}
      quality="max"
    />
    <div class="services__text">
      <h3>Representing you!</h3>
      <p>
        The Computer Science Student Society is YOUR community to find people who can be your
        academic support system. We offer past exams from our Exam Bank, class channels in our
        Discord Server, and a network of alumni to help beyond your degree. Join our Discord server
        to access our services today!
      </p>
    </div>
  </section>
  <section class="breakout">
    <h2>Learn more about us...</h2>
    <CardGallery items={navCards} as="nav" loading="eager" maxWidth={646} quality={80} />
  </section>
</article>

<style>
  article {
    display: grid;
    line-height: var(--line-height-relaxed);
    row-gap: var(--section-gap);
  }

  h2 {
    line-height: var(--line-height-relaxed);
  }

  .heading {
    color: var(--clr-accent-red);
    font-weight: var(--font-weight-normal);
    display: flex;
    flex-direction: column;
    line-height: 1;
    margin-bottom: var(--sp-5);

    > .heading__top {
      font-size: 5.5rem;
    }

    > .heading__bottom {
      font-size: 7.5rem;
    }
  }

  .membership {
    display: grid;
    row-gap: var(--content-gap);
  }

  .button-container {
    margin-block: var(--content-gap);
  }

  .services {
    display: grid;
    row-gap: var(--content-gap);
    place-items: center;
  }

  .services__student {
    display: none;
  }

  .discord {
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .services {
      grid-template: 1fr auto / 1fr 1fr;
    }

    .services__student {
      display: block;
    }

    .services__text {
      grid-area: 2 / 1 / span 1 / span 2;
    }
  }

  @media (min-width: 1000px) {
    article {
      --section-gap: var(--sp-10);
    }

    .intro {
      display: flex;
      gap: var(--content-gap);
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }

    .intro p {
      max-width: 60ch;
    }

    .services__student {
      grid-area: 1 / 1 / span 2 / span 1;
    }

    .services__text {
      grid-area: 2 / 2;
    }
  }
</style>
