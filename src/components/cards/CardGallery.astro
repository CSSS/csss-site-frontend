---
import { Image } from 'astro:assets';
import type { Polymorphic } from 'astro/types';
import type { CardItem } from 'src/types';

import LabelCard from './LabelCard.astro';
import { getAccentColour } from 'src/constants';

type GalleryElement = 'nav' | 'section';

type Props<Tag extends GalleryElement> = Polymorphic<{ as: Tag }> & {
  items: CardItem[];
  loading?: 'lazy' | 'eager';
};

const {
  as: Gallery = 'section',
  class: className,
  items,
  loading = 'lazy',
  ...props
} = Astro.props as Props<GalleryElement>;
---

<Gallery class:list={[className]} {...props}>
  <ul class="card-gallery">
    {
      items.map((item, i) => {
        return item.href ? (
          <li>
            <a href={item.href}>
              <LabelCard class="card image-reveal" label={item.label} colour={getAccentColour(i)}>
                <Image class="card__img" src={item.img} alt={item.label} loading={loading} />
              </LabelCard>
            </a>
          </li>
        ) : (
          <li>
            <LabelCard class="card image-reveal" label={item.label} colour={getAccentColour(i)}>
              <Image class="card__img" src={item.img} alt={item.label} loading={loading} />
            </LabelCard>
          </li>
        );
      })
    }
  </ul>
</Gallery>

<style>
  li {
    list-style: none;
  }

  .card {
    height: 100%;
  }

  .card__img {
    height: 100%;
    object-fit: cover;
  }

  .card-gallery {
    display: grid;
    grid-template-columns: repeat(var(--card-grid-columns), minmax(10rem, 1fr));
    gap: var(--content-gap);
  }

  @media (min-width: 35rem) {
    .card-gallery {
      --card-grid-columns: 2;
    }
  }

  @media (min-width: 70rem) {
    .card-gallery {
      --card-grid-columns: 4;
    }
  }
</style>
