---
import { Image } from 'astro:assets';
import type { Polymorphic } from 'astro/types';
import type { CardItem } from 'src/types';

import LabelCard from './LabelCard.astro';
import { getAccentColour } from 'src/constants';

type GalleryElement = 'nav' | 'section';

type Props<Tag extends GalleryElement> = Polymorphic<{ as: Tag }> & {
  items: CardItem[];
  loading?: 'lazy' | 'eager';
  minWidth?: number;
  maxWidth?: number;
  quality?: number | 'max' | 'high' | 'mid' | 'low';
};

const {
  as: Gallery = 'section',
  class: className,
  items,
  loading = 'lazy',
  minWidth = 160,
  maxWidth = 400,
  quality = 'high',
  ...props
} = Astro.props as Props<GalleryElement>;

const gridWidthVariables = `--min-width: ${minWidth}px; --max-width: ${maxWidth}px;`;
---

<Gallery class:list={[className]} {...props}>
  <ul class="card-gallery" style={gridWidthVariables}>
    {
      items.map((item, i) => {
        return item.href ? (
          <li>
            <a href={item.href} aria-label={item.label}>
              <LabelCard class="card image-reveal" label={item.label} colour={getAccentColour(i)}>
                <Image
                  class="card__img"
                  src={item.img}
                  alt={item.label}
                  loading={loading}
                  quality={quality}
                  width={maxWidth}
                />
              </LabelCard>
            </a>
          </li>
        ) : (
          <li>
            <LabelCard class="card image-reveal" label={item.label} colour={getAccentColour(i)}>
              <Image
                class="card__img"
                src={item.img}
                alt={item.label}
                loading={loading}
                quality={quality}
                width={maxWidth}
              />
            </LabelCard>
          </li>
        );
      })
    }
  </ul>
</Gallery>

<style>
  li {
    list-style: none;
  }

  .card {
    height: 100%;
    max-width: var(--max-width, 250px);
  }

  .card__img {
    height: 100%;
    object-fit: cover;
  }

  .card-gallery {
    display: grid;
    padding: 0;
    justify-content: center;
    grid-template-columns: repeat(auto-fit, minmax(var(--min-width), 1fr));
    gap: var(--content-gap);
    justify-items: center;
  }
</style>
