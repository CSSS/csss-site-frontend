---
import { type ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';
import { Image } from 'astro:assets';
import type { AccentColour } from 'src/constants';

interface Props extends HTMLAttributes<'div'> {
  title?: string;
  img?: ImageMetadata;
  colour?: AccentColour;
  alt?: string;
}

const { title, img, colour, alt, class: className, ...props } = Astro.props;

const hasFooter = Astro.slots.has('footer');
---

<div class:list={['card', 'brand__border', className]} {...props}>
  {img && <Image class="card__img" src={img} alt={alt ?? title ?? ''} />}
  {colour && <div class="gradient" style={`--clr-grad: var(--clr-accent-${colour})`} />}
  <div class="card__content">
    {title && <h2 class="card__title">{title}</h2>}
    <slot />
  </div>
  {
    hasFooter && (
      <div class="card__footer">
        <slot name="footer" />
      </div>
    )
  }
</div>

<style>
  .card {
    position: relative;
    min-height: 20rem;
    min-width: 10rem;
    overflow: hidden;
  }

  .card__img {
    position: absolute;
    height: 100%;
    object-fit: cover;
  }

  .gradient {
    position: absolute;
    height: 100%;
    width: 100%;
    color: var(--clr-grad);
    background-color: color-mix(in srgb, currentColor 10%, transparent);
    background-image: linear-gradient(to top, currentColor 35%, transparent);
  }

  .card__title {
    text-align: center;
    margin-bottom: var(--sp-4);
  }

  .card__content {
    position: relative;
    padding: var(--sp-2);
    z-index: 1;
    height: 100%;
    width: 100%;
    top: 35%;
    color: var(--clr-text-inverse);
  }

  .card__footer {
    position: absolute;
    bottom: 0;
    width: 100%;
  }
</style>
