---
import type { NavItem } from '../types';
import { ExternalLink, Menu, X } from '@lucide/astro';

interface Props {
  title: string;
  items?: NavItem[];
}

const { title, items = [] } = Astro.props;
---

<header class="navbar" transition:persist="site-navbar">
  <div class="navbar__content">
    <a class="navbar__left" href="/">
      <span class="navbar__title chip">{title}</span>
    </a>
    <nav class="navbar__nav" id="navbar-menu">
      <div class="navbar__menu-header">
        <button class="navbar__close" type="button" aria-label="Close navigation">
          <X color="black" />
        </button>
      </div>
      <ul class="navbar__list">
        {
          items.map(item => (
            <li>
              {'href' in item ? (
                <a
                  class="navbar__link"
                  href={item.href}
                  target={item.external ? '_blank' : undefined}
                  rel={item.external ? 'noopener noreferrer' : undefined}
                >
                  {item.label}
                  {item.external && <ExternalLink size={14} aria-hidden="true" />}
                </a>
              ) : (
                <Fragment>
                  <div class="dropdown dropdown--mobile">
                    <button class="navbar__link" type="button" aria-expanded="false">
                      {item.label}
                    </button>
                    <ul class="dropdown__menu">
                      {item.children.map(child => (
                        <li>
                          {'href' in child ? (
                            <a
                              class="navbar__link"
                              href={child.href}
                              target={child.external ? '_blank' : undefined}
                              rel={child.external ? 'noopener noreferrer' : undefined}
                            >
                              {child.label}
                              {child.external && <ExternalLink size={14} aria-hidden="true" />}
                            </a>
                          ) : (
                            <span class="navbar__link">{child.label}</span>
                          )}
                        </li>
                      ))}
                    </ul>
                  </div>
                  <div class="dropdown dropdown--desktop">
                    <button class="navbar__link" type="button">
                      {item.label}
                    </button>
                    <ul class="dropdown__menu">
                      {item.children.map(child => (
                        <li>
                          {'href' in child ? (
                            <a
                              class="navbar__link"
                              href={child.href}
                              target={child.external ? '_blank' : undefined}
                              rel={child.external ? 'noopener noreferrer' : undefined}
                            >
                              {child.label}
                              {child.external && <ExternalLink size={14} aria-hidden="true" />}
                            </a>
                          ) : (
                            <span class="navbar__link">{child.label}</span>
                          )}
                        </li>
                      ))}
                    </ul>
                  </div>
                </Fragment>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
    <button
      class="navbar__toggle"
      type="button"
      aria-controls="navbar-menu"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <Menu />
    </button>
  </div>
</header>

<script>
  const navbar = document.querySelector<HTMLElement>('.navbar');

  if (!navbar) {
    throw new Error('Navbar script could not find the navbar element.');
  }
  const navbarElement = navbar;
  const toggleButton = navbarElement.querySelector('.navbar__toggle') as HTMLButtonElement | null;
  const closeButton = navbarElement.querySelector('.navbar__close') as HTMLButtonElement | null;
  const navLinks = navbarElement.querySelectorAll<HTMLAnchorElement>('a.navbar__link');
  const dropdownButtons = navbarElement.querySelectorAll<HTMLButtonElement>(
    '.dropdown--mobile > button'
  );
  const desktopDropdowns = navbarElement.querySelectorAll<HTMLElement>('.dropdown--desktop');

  function closeMenu() {
    navbarElement.classList.add('navbar--menu-animate');
    navbarElement.classList.remove('navbar--menu-open');
    toggleButton?.setAttribute('aria-expanded', 'false');
  }

  let isNavigating = false;

  const updateScrolledState = () => {
    if (!isNavigating) {
      navbarElement.classList.toggle('navbar--scrolled', window.scrollY > 24);
    }
  };

  updateScrolledState();
  window.addEventListener('scroll', updateScrolledState, { passive: true });
  document.addEventListener('astro:before-preparation', () => {
    isNavigating = true;
  });
  document.addEventListener('astro:page-load', () => {
    isNavigating = false;
  });

  if (toggleButton) {
    toggleButton.addEventListener('click', () => {
      navbarElement.classList.add('navbar--menu-animate');
      const isOpen = navbarElement.classList.toggle('navbar--menu-open');
      toggleButton.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });
  }

  navLinks.forEach(link => {
    link.addEventListener('click', () => {
      closeMenu();
      const desktopDropdown = link.closest('.dropdown--desktop');
      if (desktopDropdown) {
        desktopDropdown.classList.add('dropdown--dismissed');
        link.blur();
      }
    });
  });

  desktopDropdowns.forEach(dropdown => {
    dropdown.addEventListener('pointerleave', () => {
      dropdown.classList.remove('dropdown--dismissed');
    });
    dropdown.querySelector(':scope > button')?.addEventListener('focus', () => {
      dropdown.classList.remove('dropdown--dismissed');
    });
  });

  dropdownButtons.forEach(button => {
    button.addEventListener('click', () => {
      const dropdown = button.closest('.dropdown--mobile');
      const isOpen = dropdown?.classList.toggle('dropdown--open') ?? false;
      button.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });
  });

  if (closeButton) {
    closeButton.addEventListener('click', () => {
      closeMenu();
    });
  }

  const resetMenuForViewport = () => {
    navbarElement.classList.remove('navbar--menu-open');
    navbarElement.classList.remove('navbar--menu-animate');
    toggleButton?.setAttribute('aria-expanded', 'false');
    navbarElement.querySelectorAll('.dropdown--open').forEach(dropdown => {
      dropdown.classList.remove('dropdown--open');
    });
    desktopDropdowns.forEach(dropdown => dropdown.classList.remove('dropdown--dismissed'));
    dropdownButtons.forEach(button => button.setAttribute('aria-expanded', 'false'));
  };

  window.matchMedia('(max-width: 48rem)').addEventListener('change', resetMenuForViewport);
</script>

<style>
  :root {
    --navbar-font-size: var(--font-size-2);
  }

  .navbar {
    --menu-clr-bg: var(--clr-surface-base);
    --menu-clr-fg: var(--clr-surface-inverse);
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--navbar-z-index);
    width: 100vw;
    background-color: var(--clr-surface-base);
    color: var(--clr-surface-inverse);
    height: var(--navbar-height);
    border-bottom: 1.5px solid transparent;
    transition:
      height var(--animation-duration-regular) ease,
      border-color var(--animation-duration-regular) ease;
    padding: 0 var(--sp-2);

    display: flex;
    align-items: center;
  }

  .navbar__content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--sp-6);
    width: 100%;
  }

  .navbar__nav {
    position: fixed;
    top: 0;
    right: 0;
    width: 16.5rem;
    max-width: 100vw;
    height: 100vh;
    background-color: var(--menu-clr-bg);
    transform: translateX(100%);
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    padding: var(--sp-6);
    overflow-y: auto;
    z-index: 1;
  }

  .navbar--menu-animate .navbar__nav {
    transition: transform var(--animation-duration-regular) ease;
  }

  .navbar--menu-open .navbar__nav {
    transform: translateX(0);
    color: var(--clr-surface-base);
    border-left: 1px solid var(--menu-clr-fg);
  }

  .navbar--scrolled {
    height: var(--navbar-height-scrolled);
    border-bottom-color: var(--csss-brand-grey);
  }

  .navbar__left {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    border: 1px var(--clr-surface-inverse);
  }

  .navbar__title {
    font-size: var(--navbar-font-size);
    font-family: var(--font-navbar);
    font-weight: var(--font-weight-regular);
    color: var(--csss-brand-black);
    white-space: nowrap;
  }

  .navbar__list {
    display: flex;
    flex-direction: column;
    align-items: baseline;
    gap: var(--sp-4);
  }

  .navbar__link {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-family: var(--font-navbar);
    font-weight: var(--font-weight-regular);
    font-size: var(--navbar-font-size);
    text-decoration: none;
    color: var(--csss-brand-black);
  }

  .dropdown {
    position: relative;
  }

  .dropdown--desktop {
    display: none;
  }

  .dropdown button {
    background: none;
    cursor: pointer;
    font-size: var(--navbar-font-size);
  }

  .dropdown--open .dropdown__menu {
    display: flex;
  }

  .dropdown__menu {
    display: none;
    top: 100%;
    left: 0;
    flex-direction: column;
    min-width: 10rem;
    overflow: hidden;
    gap: var(--sp-2);
    margin-top: var(--sp-2);
  }

  .dropdown__menu li {
    width: 100%;
    padding: 0 var(--sp-2);
    display: flex;
    align-items: center;
  }

  .dropdown__menu li:hover {
    background-color: var(--clr-surface-hover);
  }

  .dropdown__menu a {
    display: flex;
    padding: var(--sp-2) 0rem;
    white-space: nowrap;
  }

  .navbar__toggle {
    display: inline-flex;
    padding: var(--sp-2);
    background: none;
    border: none;
    cursor: pointer;
    color: inherit;
  }

  .navbar__menu-header {
    display: flex;
    justify-content: flex-end;
    width: 100%;
  }

  .navbar__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--sp-2);
    background: none;
    border: none;
    cursor: pointer;
    color: inherit;
  }

  ExternalLink {
    display: inline-flex;
    align-items: center;
  }

  @media (min-width: 48rem) {
    .navbar {
      --menu-clr-bg: var(--clr-surface-base);
      --menu-clr-fg: var(--clr-surface-inverse);
      justify-content: center;
      padding: 0;
    }

    .navbar__content {
      display: grid;
      grid-template-columns: 1fr 2fr 0;
      padding: 0 var(--sp-4);
    }

    .navbar__nav {
      position: static;
      width: auto;
      max-width: none;
      height: auto;
      transform: none;
      background-color: transparent;
      justify-content: center;
      overflow: visible;
      transition: none;
    }

    .navbar__list {
      flex-direction: row;
      justify-content: flex-end;
      gap: var(--sp-5);
    }

    .navbar__toggle {
      display: none;
    }

    .navbar__menu-header {
      display: none;
    }

    .dropdown__menu {
      position: absolute;
      top: calc(100% + var(--sp-1));
      margin-top: 0;
      background-color: var(--menu-clr-bg);
      border: 1px solid var(--menu-clr-fg);
      border-radius: var(--border-radius-default);
    }

    .dropdown--mobile {
      display: none;
    }

    .dropdown--desktop {
      display: block;
    }

    .navbar__list > li > a.navbar__link,
    .dropdown--desktop > button.navbar__link {
      padding: 0.125rem 0.375rem;
      border: var(--border-default);
      border-radius: var(--border-radius-default);
    }

    .dropdown--desktop > button.navbar__link {
      position: relative;
    }

    .dropdown--desktop > button.navbar__link::after {
      content: '';
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      height: var(--sp-2);
      pointer-events: none;
    }

    .dropdown--desktop:hover > button.navbar__link::after,
    .dropdown--desktop:focus-within > button.navbar__link::after {
      pointer-events: auto;
    }

    .dropdown--desktop:hover .dropdown__menu,
    .dropdown--desktop:focus-within .dropdown__menu {
      display: flex;
    }

    .dropdown--desktop.dropdown--dismissed .dropdown__menu {
      display: none;
    }
  }
</style>
