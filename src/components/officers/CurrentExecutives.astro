---
import adoe from '@assets/images/execs/adoe.jpg';
import doc from '@assets/images/execs/doc.jpg';
import eal1 from '@assets/images/execs/eal1.jpg';
import eal2 from '@assets/images/execs/eal2.jpg';
import doe from '@assets/images/execs/doe.jpg';
import doee from '@assets/images/execs/doee.jpg';
import dor from '@assets/images/execs/dor.jpg';
import president from '@assets/images/execs/president.jpg';
import secretary from '@assets/images/execs/secretary.jpg';
import sfssrep from '@assets/images/execs/sfssrep.jpg';
import treasurer from '@assets/images/execs/treasurer.jpg';
import vp from '@assets/images/execs/vp.jpg';
import { type ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Exec {
  role:
    | 'president'
    | 'vp'
    | 'treasurer'
    | 'secretary'
    | 'doe'
    | 'doee'
    | 'adoe'
    | 'doc'
    | 'dor'
    | 'sfssrep'
    | 'eal';
  name: string;
  label: string;
  img: ImageMetadata;
}

const execs: Exec[] = [
  { role: 'president', name: 'Samantha Gan', label: 'President', img: president },
  {
    role: 'vp',
    name: 'Mengna Ma',
    label: 'Vice-President',
    img: vp
  },
  {
    role: 'treasurer',
    name: 'Megan Chau',
    label: 'Treasurer',
    img: treasurer
  },
  { role: 'secretary', name: 'Arielle Felicia', label: 'Secretary', img: secretary },
  {
    role: 'dor',
    name: 'Phoebe Cai',
    label: 'Director of Resources',
    img: dor
  },
  { role: 'doc', name: 'Amelia Shen', label: 'Director of Communications', img: doc },
  {
    role: 'doe',
    name: 'Hamzah Alshawwaf',
    label: 'Director of Events',
    img: doe
  },
  {
    role: 'doee',
    name: 'Daniel Smith',
    label: 'Director of Educational Events',
    img: doee
  },
  {
    role: 'adoe',
    name: 'Sia Garg',
    label: 'Assistant Director of Events',
    img: adoe
  },
  {
    role: 'sfssrep',
    name: 'Melody Oh',
    label: 'SFSS Council Representative',
    img: sfssrep
  },
  {
    role: 'eal',
    name: 'Jayson Wu',
    label: 'Executive at Large',
    img: eal1
  },
  {
    role: 'eal',
    name: 'Alex Ng',
    label: 'Executive at Large',
    img: eal2
  }
];
---

<section>
  {
    execs.map((exec, index) => (
      <div class="card">
        <Image
          class="image-reveal"
          src={exec.img}
          alt={exec.role}
          width={300}
          priority={index < 7}
          quality="max"
        />
        <h3>{exec.name}</h3>
        <p>{exec.label}</p>
      </div>
    ))
  }
</section>

<style>
  section {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    justify-items: center;
    row-gap: var(--sp-6);
  }

  .card {
    max-width: 300px;
  }
</style>
