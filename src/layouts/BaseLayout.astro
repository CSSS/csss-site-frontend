---
import type { ImageMetadata } from 'astro';
import Seo from '../components/Seo.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/reset.css';
import '../styles/fonts.css';
import '../styles/theme.css';

interface Props {
  pageTitle: string;
  description?: string;
  image?: ImageMetadata | string;
  noindex?: boolean;
}

const { pageTitle, description, image, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/static/icons/favicon_colourful.svg" />
    <Seo title={pageTitle} description={description} image={image} noindex={noindex} />
    <slot name="head" />
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <slot />
  </body>
</html>
