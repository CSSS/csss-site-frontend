---
import '../styles/reset.css';
import '../styles/fonts.css';
import '../styles/theme.css';

import type { ImageMetadata } from 'astro';
import { ClientRouter } from 'astro:transitions';

import Seo from '@components/Seo.astro';

interface Props {
  pageTitle: string;
  description?: string;
  image?: ImageMetadata | string;
  noindex?: boolean;
}

const { pageTitle, description, image, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="CSSS" />
    <link rel="manifest" href="/site.webmanifest" />
    <Seo title={pageTitle} description={description} image={image} noindex={noindex} />
    <slot name="head" />
    <ClientRouter fallback="swap" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <slot />
    <script>
      function initializeImageReveals() {
        document.querySelectorAll<HTMLElement>('.image-reveal:not(.is-loaded)').forEach(element => {
          const image =
            element instanceof HTMLImageElement ? element : element.querySelector('img');
          const reveal = () => element.classList.add('is-loaded');

          if (!image || image.complete) {
            reveal();
          } else {
            image.addEventListener('load', reveal, { once: true });
            image.addEventListener('error', reveal, { once: true });
          }
        });
      }

      document.addEventListener('astro:page-load', initializeImageReveals);
    </script>
  </body>
</html>
