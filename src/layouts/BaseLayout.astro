---
import '../styles/reset.css';
import '../styles/fonts.css';
import '../styles/theme.css';

import type { ImageMetadata } from 'astro';
import { ClientRouter } from 'astro:transitions';

import Seo from '@components/Seo.astro';

interface Props {
  pageTitle: string;
  description?: string;
  image?: ImageMetadata | string;
  noindex?: boolean;
}

const { pageTitle, description, image, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="CSSS" />
    <link rel="manifest" href="/site.webmanifest" />
    <Seo title={pageTitle} description={description} image={image} noindex={noindex} />
    <slot name="head" />
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <slot />
    <script>
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      let revealContext: ReturnType<typeof gsap.context> | undefined;

      function initializeScrollReveals() {
        revealContext?.revert();

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          revealContext = undefined;
          return;
        }

        revealContext = gsap.context(context => {
          const elements = gsap.utils.toArray<HTMLElement>('.image-reveal');

          gsap.set(elements, { autoAlpha: 0, y: 12 });
          ScrollTrigger.batch(elements, {
            start: 'top 90%',
            onEnter: (batch, triggers) => {
              triggers.forEach(trigger => trigger.kill());
              context.add(() => {
                gsap.to(batch, {
                  autoAlpha: 1,
                  y: 0,
                  duration: 0.5,
                  ease: 'power2.out',
                  stagger: 0.1,
                  clearProps: 'transform,opacity,visibility'
                });
              });
            }
          });
        });

        ScrollTrigger.refresh();
      }

      document.addEventListener('astro:before-swap', () => {
        revealContext?.revert();
        revealContext = undefined;
      });
      document.addEventListener('astro:page-load', initializeScrollReveals);
    </script>
  </body>
</html>
