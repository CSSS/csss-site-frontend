---
import '../styles/mdx.css';

import type { ImageMetadata } from 'astro';
import SiteLayout from './SiteLayout.astro';

interface PageMetadata {
  title: string;
  description?: string;
  noindex?: boolean;
  banner: string;
}

interface Props extends PageMetadata {
  frontmatter: PageMetadata;
}

const { frontmatter } = Astro.props;
const pageTitle = frontmatter.title;

if (!pageTitle) {
  throw new Error('MarkdownLayout requires a page title.');
}

const images = import.meta.glob<ImageMetadata>('/src/assets/images/**/*.{avif,jpeg,jpg,png,webp}', {
  eager: true,
  import: 'default'
});

const pageDescription = frontmatter.description;
const pageNoindex = frontmatter.noindex;
const pageBanner = images[frontmatter.banner];
---

<SiteLayout
  title={pageTitle}
  description={pageDescription}
  noindex={pageNoindex}
  banner={pageBanner}
>
  <article class="mdx-content content-grid full-width">
    <slot />
  </article>
</SiteLayout>
