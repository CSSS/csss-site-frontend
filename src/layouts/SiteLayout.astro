---
import Footer from '@components/Footer.astro';
import Navbar from '@components/Navbar.astro';
import { footerNavItems, navItems, siteConfig } from '../config/site';
import CsssIcon from '../icons/CsssIcon.astro';
import BaseLayout from './BaseLayout.astro';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface PageMetadata {
  title: string;
  description?: string;
  noindex?: boolean;
  banner?: ImageMetadata;
}

interface Props extends PageMetadata {
  frontmatter?: PageMetadata;
}

const { frontmatter, title, description, noindex, banner } = Astro.props;
const pageTitle = frontmatter?.title ?? title;

if (!pageTitle) {
  throw new Error('SiteLayout requires a page title.');
}

const pageDescription = frontmatter?.description ?? description ?? siteConfig.description;
const pageNoindex = frontmatter?.noindex ?? noindex ?? false;
---

<BaseLayout pageTitle={pageTitle} description={pageDescription} noindex={pageNoindex}>
  <Navbar title="SFU CSSS" items={navItems}>
    <CsssIcon slot="icon" size={36} />
  </Navbar>
  <main class="page-content content-grid">
    {
      banner && (
        <hgroup class="banner breakout">
          <Image
            class="banner__img"
            src={banner}
            alt={`${pageTitle} banner`}
            quality="high"
            priority
          />
          <h1 class="banner__title">{pageTitle}</h1>
        </hgroup>
      )
    }
    <slot />
  </main>
  <Footer config={siteConfig} navItems={footerNavItems} />
</BaseLayout>

<style is:global>
  .page-content {
    min-height: calc(100vh - var(--navbar-height));
    row-gap: var(--sp-5);
    align-content: start;
  }

  ul.contains-task-list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .banner {
    position: relative;
    height: 12rem;
  }

  .banner__title {
    position: absolute;
    text-align: center;
    z-index: 1;
    color: var(--clr-text-inverse);
    bottom: 0;
    width: 100%;
  }

  .banner__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
    filter: brightness(0.4);
  }
</style>
