---
import { siFacebook } from 'simple-icons';

interface Props {
  size?: number;
  color?: string; // Accepts a CSS colour or variable
}

const { size = 24, color = 'currentColor' } = Astro.props;
---

<svg
  role="img"
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill={color}
>
  <title>Facebook</title>
  <path d={siFacebook.path}></path>
</svg>
